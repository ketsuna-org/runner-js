{
  "name": "runner-js",
  "version": "0.5.0",
  "description": "Bot Creator JS Runner — HTTP handler for pure JavaScript Discord bots",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "compile:linux-x64": "bun build --compile --minify src/index.ts --outfile build/bot-creator-runner-js-linux-x64",
    "compile:linux-arm64": "bun build --compile --minify src/index.ts --outfile build/bot-creator-runner-js-linux-arm64",
    "compile:win-x64": "bun build --compile --minify src/index.ts --outfile build/bot-creator-runner-js-win.exe",
    "compile:macos-arm64": "bun build --compile --minify src/index.ts --outfile build/bot-creator-runner-js-macos-arm64"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@snazzah/davey": "^0.1.9",
    "bufferutil": "^4.0.9",
    "canvas": "^3.1.0",
    "discord.js": "^14.21.0",
    "ffmpeg-static": "^5.2.0",
    "hono": "^4.7.4",
    "libsodium-wrappers": "^0.7.15",
    "sodium-native": "^4.3.3",
    "zlib-sync": "^0.1.10",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.2.4",
    "@types/node": "^22.16.5",
    "typescript": "^5.8.3"
  }
}
