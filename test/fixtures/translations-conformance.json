   "args": {
    "1": "Bob",
    "2": "a sword"
   },
   "expected": "Bob bought a sword"
  },
  {
   "message": "Hi {name}",
   "locale": "en-US",
   "args": {},
   "expected": "Hi {name}"
  },
  {
   "message": "d'objets et l''autre",
   "locale": "fr",
   "args": {},
   "expected": "d'objets et l'autre"
  },
  {
   "message": "'{'literal'}' and {x}",
   "locale": "en-US",
   "args": {
