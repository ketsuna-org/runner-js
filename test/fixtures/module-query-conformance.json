{
  "doc": {
    "translations": {
      "defaultLocale": "fr"
    },
    "modules": {
      "tickets": {
        "version": "1.2.0",
        "name": {
          "en": "Tickets",
          "fr": "Billets"
        },
        "entities": [
          {
            "kind": "command",
            "name": "ticket"
          },
          {
            "kind": "workflow",
            "name": "ticket-close"
          },
          {
            "kind": "translation",
            "name": "mod.tickets.hello"
          }
        ],
        "features": [
          {
            "key": "transcripts",
            "name": {
              "en": "Transcripts",
              "fr": "Transcriptions"
            },
            "entities": [
              "setting:transcript-channel"
            ],
            "requires": []
          },
          {
            "key": "claims",
            "name": {
              "en": "Claims"
            },
            "entities": [
              "command:claim"
            ],
            "requires": [
              "transcripts",
              "welcome:greeting"
            ]
          }
        ],
        "disabledFeatures": [
          "transcripts"
        ],
        "settings": [
          {
            "key": "category",
            "type": "channel",
            "scope": "guild",
            "default": null,
            "i18n": {
              "en": {
                "label": "Category",
                "description": "Where tickets open"
              },
              "fr": {
                "label": "Catégorie",
                "description": "Où ils s’ouvrent"
              }
            }
          },
          {
            "key": "max-open",
            "type": "number",
            "scope": "guild",
            "default": 3,
            "min": 1,
            "max": 10,
            "i18n": {
              "en": {
                "label": "Open tickets",
                "description": "Per person"
              }
            }
          },
          {
            "key": "transcript-channel",
            "type": "channel",
            "scope": "guild",
            "default": null,
            "i18n": {
              "en": {
                "label": "Transcripts",
                "description": "Where they go"
              }
            }
          },
          {
            "key": "style",
            "type": "choice",
            "scope": "guild",
            "default": "embed",
            "choices": [
              "embed",
              "plain"
            ],
            "i18n": {
              "en": {
                "label": "Style",
                "description": ""
              }
            }
          },
          {
            "key": "ping-staff",
            "type": "toggle",
            "scope": "guild",
            "default": true,
            "i18n": {
              "en": {
                "label": "Ping staff",
                "description": ""
              }
            }
          },
          {
            "key": "secret",
            "type": "text",
            "scope": "global",
            "default": "x",
            "i18n": {
              "en": {
                "label": "Secret",
                "description": ""
              }
            }
          }
        ]
      },
      "welcome": {
        "version": "1.0.0",
        "name": {
          "en": "Welcome"
        },
        "entities": [
          {
            "kind": "command",
            "name": "welcome"
          }
        ],
        "features": [],
        "disabledFeatures": [],
        "settings": [],
        "enabled": false
      }
    }
  },
  "commands": [
    {
      "name": "ticket",
      "description": "Open a ticket",
      "triggerType": "slash",
      "data": {
        "commandType": "chatInput",
        "options": [
          {
            "type": "subCommand",
            "name": "open",
            "description": "Open one",
            "options": [
              {
                "type": "string",
                "name": "reason",
                "required": true
              },
              {
                "type": "string",
                "name": "note"
              }
            ]
          },
          {
            "type": "subCommandGroup",
            "name": "staff",
            "description": "Staff tools",
            "options": [
              {
                "type": "subCommand",
                "name": "claim",
                "description": "Claim it",
                "options": [
                  {
                    "type": "user",
                    "name": "who",
                    "required": true
                  }
                ]
              }
            ]
          }
        ],
        "localizations": {
          "name": {
            "fr": "billet"
          },
          "description": {
            "fr": "Ouvrir un billet"
          }
        }
      }
    },
    {
      "name": "welcome",
      "description": "Welcome tools",
      "triggerType": "slash",
      "data": {
        "commandType": "chatInput",
        "options": []
      }
    },
    {
      "name": "hello",
      "description": "Say hello",
      "triggerType": "slash",
      "data": {
        "commandType": "chatInput",
        "options": [
          {
            "type": "user",
            "name": "who",
            "required": true
          },
          {
            "type": "string",
            "name": "style"
          }
        ]
      }
    },
    {
      "name": "ping",
      "description": "Text ping",
      "triggerType": "text",
      "data": {
        "commandType": "chatInput",
        "options": []
      }
    }
  ],
