{
  "version": 1,
  "description": "Vecteurs communs de l'analyse d'invocation d'un message (parseInvocation / sanitizePrefixValue). A copier a l'identique dans le depot bot-creator (runner Dart) : un seul comportement pour le runner JS et le runner Dart. Regles : prefixe le plus long d'abord, sans repli sur un prefixe plus court ; un prefixe vide ne correspond jamais ; la mention <@id> ou <@!id> du bot doit etre en tete et suivie d'un espace (ou de la fin) ; nom en minuscules ; espaces de tete ignores ; les gardes (auteur bot, webhook, message systeme) sont hors du parseur.",
  "botId": "123456789012345678",
  "parse": [
    { "name": "prefixe simple", "content": "!ping", "prefixes": ["!"], "expected": { "source": "prefix", "prefix": "!", "name": "ping", "args": [], "rawArgs": "" } },
    { "name": "prefixe avec arguments", "content": "!ping a b", "prefixes": ["!"], "expected": { "source": "prefix", "prefix": "!", "name": "ping", "args": ["a", "b"], "rawArgs": "a b" } },
    { "name": "nom en minuscules", "content": "!PING Ab", "prefixes": ["!"], "expected": { "source": "prefix", "prefix": "!", "name": "ping", "args": ["Ab"], "rawArgs": "Ab" } },
    { "name": "prefixe suivi d'un espace (accepte comme aujourd'hui)", "content": "! ping", "prefixes": ["!"], "expected": { "source": "prefix", "prefix": "!", "name": "ping", "args": [], "rawArgs": "" } },
    { "name": "prefixe seul", "content": "!", "prefixes": ["!"], "expected": null },
    { "name": "prefixe puis espaces", "content": "!   ", "prefixes": ["!"], "expected": null },
    { "name": "espace en tete ignore", "content": "  !ping", "prefixes": ["!"], "expected": { "source": "prefix", "prefix": "!", "name": "ping", "args": [], "rawArgs": "" } },
    { "name": "contenu vide", "content": "", "prefixes": ["!"], "expected": null },
    { "name": "pas de prefixe, pas de sans-prefixe", "content": "ping", "prefixes": ["!"], "expected": null },
    { "name": "aucun prefixe configure", "content": "!ping", "prefixes": [], "expected": null },
    { "name": "un prefixe vide ne correspond jamais", "content": "ping", "prefixes": [""], "expected": null },
    { "name": "un prefixe vide est ignore, les autres servent", "content": "!ping", "prefixes": ["", "!"], "expected": { "source": "prefix", "prefix": "!", "name": "ping", "args": [], "rawArgs": "" } },
    { "name": "plusieurs prefixes : le second", "content": "?ping", "prefixes": ["!", "?"], "expected": { "source": "prefix", "prefix": "?", "name": "ping", "args": [], "rawArgs": "" } },
    { "name": "le plus long gagne (liste triee)", "content": "!!ping", "prefixes": ["!!", "!"], "expected": { "source": "prefix", "prefix": "!!", "name": "ping", "args": [], "rawArgs": "" } },
    { "name": "le plus long gagne (liste non triee)", "content": "!!ping", "prefixes": ["!", "!!"], "expected": { "source": "prefix", "prefix": "!!", "name": "ping", "args": [], "rawArgs": "" } },
    { "name": "le plus court sert quand le long ne correspond pas", "content": "!ping", "prefixes": ["!!", "!"], "expected": { "source": "prefix", "prefix": "!", "name": "ping", "args": [], "rawArgs": "" } },
    { "name": "sans repli : !!x avec le seul prefixe !", "content": "!!ping", "prefixes": ["!"], "expected": { "source": "prefix", "prefix": "!", "name": "!ping", "args": [], "rawArgs": "" } },
    { "name": "prefixe sensible a la casse", "content": "bcping", "prefixes": ["Bc"], "expected": null },
    { "name": "prefixe emoji", "content": "🔥ping x", "prefixes": ["🔥"], "expected": { "source": "prefix", "prefix": "🔥", "name": "ping", "args": ["x"], "rawArgs": "x" } },
    { "name": "arguments sur plusieurs lignes", "content": "!say a\nb", "prefixes": ["!"], "expected": { "source": "prefix", "prefix": "!", "name": "say", "args": ["a", "b"], "rawArgs": "a\nb" } },
    { "name": "tabulation entre le nom et les arguments", "content": "!ping\ta", "prefixes": ["!"], "expected": { "source": "prefix", "prefix": "!", "name": "ping", "args": ["a"], "rawArgs": "a" } },
    { "name": "espace insecable entre le nom et les arguments", "content": "!ping a", "prefixes": ["!"], "expected": { "source": "prefix", "prefix": "!", "name": "ping", "args": ["a"], "rawArgs": "a" } },
    { "name": "espaces multiples : rawArgs garde l'intérieur, rogne les bords", "content": "!ping   a    b  ", "prefixes": ["!"], "expected": { "source": "prefix", "prefix": "!", "name": "ping", "args": ["a", "b"], "rawArgs": "a    b" } },

    { "name": "mention", "content": "<@123456789012345678> ping", "prefixes": [], "mentionEnabled": true, "expected": { "source": "mention", "prefix": null, "name": "ping", "args": [], "rawArgs": "" } },
    { "name": "mention avec pseudo (<@!id>) et arguments", "content": "<@!123456789012345678> ping a b", "prefixes": [], "mentionEnabled": true, "expected": { "source": "mention", "prefix": null, "name": "ping", "args": ["a", "b"], "rawArgs": "a b" } },
    { "name": "mention : nom en minuscules", "content": "<@123456789012345678> PING", "prefixes": [], "mentionEnabled": true, "expected": { "source": "mention", "prefix": null, "name": "ping", "args": [], "rawArgs": "" } },
    { "name": "mention puis retour a la ligne", "content": "<@123456789012345678>\nping x", "prefixes": [], "mentionEnabled": true, "expected": { "source": "mention", "prefix": null, "name": "ping", "args": ["x"], "rawArgs": "x" } },
    { "name": "mention puis tabulation", "content": "<@123456789012345678>\tping", "prefixes": [], "mentionEnabled": true, "expected": { "source": "mention", "prefix": null, "name": "ping", "args": [], "rawArgs": "" } },
    { "name": "mention avec d'autres mentions en argument", "content": "<@123456789012345678> ban <@456> spam", "prefixes": [], "mentionEnabled": true, "expected": { "source": "mention", "prefix": null, "name": "ban", "args": ["<@456>", "spam"], "rawArgs": "<@456> spam" } },
    { "name": "mention seule : rien", "content": "<@123456789012345678>", "prefixes": [], "mentionEnabled": true, "expected": null },
    { "name": "mention puis espaces : rien", "content": "<@123456789012345678>   ", "prefixes": [], "mentionEnabled": true, "expected": null },
    { "name": "mention desactivee", "content": "<@123456789012345678> ping", "prefixes": [], "mentionEnabled": false, "expected": null },
    { "name": "mention de role", "content": "<@&123456789012345678> ping", "prefixes": [], "mentionEnabled": true, "expected": null },
    { "name": "mention d'un autre utilisateur", "content": "<@999> ping", "prefixes": [], "mentionEnabled": true, "expected": null },
    { "name": "@everyone n'est pas un declencheur", "content": "@everyone ping", "prefixes": [], "mentionEnabled": true, "expected": null },
    { "name": "@here n'est pas un declencheur", "content": "@here ping", "prefixes": [], "mentionEnabled": true, "expected": null },
    { "name": "mention hors de la tete du message", "content": "salut <@123456789012345678> ping", "prefixes": [], "mentionEnabled": true, "expected": null },
    { "name": "mention collee au mot suivant", "content": "<@123456789012345678>ping", "prefixes": [], "mentionEnabled": true, "expected": null },
    { "name": "identifiant du bot absent", "content": "<@123456789012345678> ping", "botId": null, "prefixes": [], "mentionEnabled": true, "expected": null },
    { "name": "identifiant du bot non numerique", "content": "<@abc> ping", "botId": "abc", "prefixes": [], "mentionEnabled": true, "expected": null },
    { "name": "le prefixe l'emporte sur la mention", "content": "<@123456789012345678> ping", "prefixes": ["<"], "mentionEnabled": true, "expected": { "source": "prefix", "prefix": "<", "name": "@123456789012345678>", "args": ["ping"], "rawArgs": "ping" } },
    { "name": "un message prefixe reste prefixe quand la mention est active", "content": "!ping", "prefixes": ["!"], "mentionEnabled": true, "expected": { "source": "prefix", "prefix": "!", "name": "ping", "args": [], "rawArgs": "" } },

    { "name": "sans prefixe", "content": "ping", "prefixes": ["!"], "noPrefixEnabled": true, "expected": { "source": "noPrefix", "prefix": null, "name": "ping", "args": [], "rawArgs": "" } },
    { "name": "sans prefixe avec arguments et casse", "content": "PING a  b", "prefixes": [], "noPrefixEnabled": true, "expected": { "source": "noPrefix", "prefix": null, "name": "ping", "args": ["a", "b"], "rawArgs": "a  b" } },
    { "name": "sans prefixe desactive", "content": "ping", "prefixes": ["!"], "noPrefixEnabled": false, "expected": null },
    { "name": "le message prefixe gagne sur le sans-prefixe", "content": "!ping", "prefixes": ["!"], "noPrefixEnabled": true, "expected": { "source": "prefix", "prefix": "!", "name": "ping", "args": [], "rawArgs": "" } },
    { "name": "la mention gagne sur le sans-prefixe", "content": "<@123456789012345678> ping", "prefixes": [], "mentionEnabled": true, "noPrefixEnabled": true, "expected": { "source": "mention", "prefix": null, "name": "ping", "args": [], "rawArgs": "" } },
    { "name": "sans prefixe : espaces de tete ignores", "content": "  ping", "prefixes": [], "noPrefixEnabled": true, "expected": { "source": "noPrefix", "prefix": null, "name": "ping", "args": [], "rawArgs": "" } },
    { "name": "sans prefixe : contenu vide", "content": "   ", "prefixes": [], "noPrefixEnabled": true, "expected": null }
  ],
  "sanitize": [
    { "name": "un prefixe", "value": "?", "expected": ["?"] },
    { "name": "separes par un espace", "value": "! ?", "expected": ["!", "?"] },
    { "name": "separes par une virgule", "value": "!,?", "expected": ["!", "?"] },
    { "name": "espaces et virgules melanges", "value": "  !  ,  ? ", "expected": ["!", "?"] },
    { "name": "separes par un retour a la ligne", "value": "!\n?", "expected": ["!", "?"] },
    { "name": "le plus long d'abord", "value": "! ??", "expected": ["??", "!"] },
    { "name": "'a b' donne deux prefixes", "value": "a b", "expected": ["a", "b"] },
    { "name": "vide", "value": "", "expected": [] },
    { "name": "espaces seuls", "value": "   ", "expected": [] },
    { "name": "virgules seules", "value": " , ,, ", "expected": [] },
    { "name": "40 caracteres : entree ecartee", "value": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "expected": [] },
    { "name": "5 caracteres acceptes, 6 refuses", "value": "12345 123456", "expected": ["12345"] },
    { "name": "20 entrees : les 5 premieres", "value": "a b c d e f g h i j k l m n o p q r s t", "expected": ["a", "b", "c", "d", "e"] },
    { "name": "doublons", "value": "! ! !", "expected": ["!"] },
    { "name": "emoji = 1 point de code", "value": "🔥", "expected": ["🔥"] },
    { "name": "5 emojis acceptes", "value": "🔥🔥🔥🔥🔥", "expected": ["🔥🔥🔥🔥🔥"] },
    { "name": "6 emojis refuses (12 unites UTF-16)", "value": "🔥🔥🔥🔥🔥🔥", "expected": [] },
    { "name": "sequence ZWJ de 5 points de code", "value": "👨‍👩‍👧", "expected": ["👨‍👩‍👧"] },
    { "name": "accent decompose (2 points de code)", "value": "é !", "expected": ["é", "!"] },
    { "name": "valeur de plus de 256 caracteres : ignoree", "value": "! ?                                                                                                                                                                                                                                                                                  .", "expected": [] },
    { "name": "nombre : ignore", "value": 42, "expected": [] },
    { "name": "booleen : ignore", "value": true, "expected": [] },
    { "name": "null : ignore", "value": null, "expected": [] },
    { "name": "tableau : ignore", "value": ["!", "?"], "expected": [] },
    { "name": "objet : ignore", "value": { "prefix": "!" }, "expected": [] }
  ]
}
